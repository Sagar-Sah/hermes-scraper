# Copy to .env and generate your own values before using Docker Compose.
# API token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ATLAS_API_TOKEN=
# Fernet key: python3 -c 'import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# Keep this key unchanged; it decrypts stored supplier / AI credentials.
ATLAS_SECRET_KEY=
# Hex avoids URL-escaping requirements in DATABASE_URL.
# Password: python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=
ATLAS_PORT=18877
ATLAS_PRODUCT_CONCURRENCY=100
ATLAS_SOURCE_RPS=2
ATLAS_SOURCE_CONCURRENCY=2
ATLAS_CACHE_SECONDS=86400
# Local development proxy; not used by the built dashboard.
ATLAS_API_URL=http://127.0.0.1:18877
# Local Python development: leave DATABASE_URL unset to use SQLite in ATLAS_DATA_DIR.
# Docker Compose sets both variables explicitly.
# ATLAS_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://atlas:YOUR_PASSWORD@localhost:5432/atlas
# Normal browser sessions, only when authorized and required:
ATLAS_BROWSER_PRODUCT_CONCURRENCY=1
ATLAS_BROWSER_PERSIST_SESSION=true
# ATLAS_BROWSER_HEADLESS=true
# ATLAS_BROWSER_PROFILE_DIR=/data/browser-profile
# ATLAS_BROWSER_STORAGE_STATE=/data/storage-state.json
# ATLAS_BROWSER_AUTH_WAIT_SECONDS=0
# ATLAS_BROWSER_INACTIVITY_SECONDS=30
# Optional response object mirroring through boto3:
# ATLAS_S3_BUCKET=your-bucket
# ATLAS_S3_ENDPOINT=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
